# --- Active git provider ---------------------------------------------------
git_provider:
  type: gitlab          # gitlab | codeup

# --- GitLab credentials ----------------------------------------------------
# Verified against: GitLab CE 17.6.0 (docker image: gitlab/gitlab-ce:17.6.0-ce.0)
# SDK: python-gitlab 4.8.0
#
# Supported token types (all use the same `access_token` field):
#   - Personal Access Token (PAT): user-level, scope: api
#   - Project Access Token: project-level, not bound to a personal account
#   - Group Access Token: group-level, covers all projects in the group
# Generate at: GitLab → Settings → Access Tokens (user/project/group level).
# Required scope: api (read_api is insufficient for member listing).
gitlab:
  url: "http://gitlab.local"
  access_token: "<YOUR_GITLAB_TOKEN>"
  group_id: null
  project_id: null
  # Fetch per-repo detail for richer fields. Set false to speed up large
  # instances at the cost of detail-level attributes.
  fetch_details: true
  release_tag: null

acr:
  instance_id: "<YOUR_ACR_INSTANCE_ID>"
  region: "cn-hangzhou"
  # &ak / &sk anchors: fill AK/SK once here; cms/sls reuse via *ak / *sk.
  access_key_id: &ak "<YOUR_ACCESS_KEY_ID>"
  access_key_secret: &sk "<YOUR_ACCESS_KEY_SECRET>"
  # 0 = unlimited (pull all); set a number to cap per-API results
  max_repositories: 0       # max ACR registries to pull
  max_tags_per_repo: 0      # max image tags per registry
  # Pacing between ListRepoTag API calls (ms). Prevention, not retry/backoff.
  fetch_interval_ms: 200
  # Optional whitelist of repo full-namespace names to fetch (e.g.
  # ["library/nginx"]). Empty = fetch all repos in the instance.
  repo_filter: []

cms:
  endpoint: "metrics.<YOUR_REGION_ID>.aliyuncs.com"
  workspace: "<YOUR_CMS_WORKSPACE>"
  namespace_filter: "<YOUR_NAMESPACE_FILTER>"
  access_key_id: *ak
  access_key_secret: *sk

kubernetes:
  # "k8s": read pods directly from kubeconfig
  # "cms": read pods from the CMS workspace EntityStore
  data_source: "k8s"
  cluster_id: "<YOUR_CLUSTER_ID>"
  namespace_filter: "<YOUR_NAMESPACE_FILTER>"
  kubeconfig_path: ""
  k8s_context: ""

static_topo:
  static_topo_config: "config/static_topo.yaml"

# --- Argo CD（可选；server 有真实值才会启用 deployment 生产者） -------------
argocd:
  server: "<YOUR_ARGOCD_SERVER>"   # 如 http://nlb-xxx:8080（不带尾斜杠）
  token: "<YOUR_ARGOCD_TOKEN>"     # Bearer token；留空则不启用
  insecure: true                   # 自签证书跳过 TLS 校验
  app_filter: []                   # 可选：只采集这些 application；空 = 全部
  repo_mapping: {}                 # repoURL → GitLab 项目 id，用于归一 repository_id
                                   # 如 "http://nlb-xxx:8080/starops-demo/demo-app.git": "1"

sls:
  endpoint: "cn-hongkong.log.aliyuncs.com"
  access_key_id: *ak
  access_key_secret: *sk
  project: "<YOUR_SLS_PROJECT>"
  logstore_mapping:
    entities:
      user: "<YOUR_ENTITY_NAME>"
      repository: "<YOUR_ENTITY_NAME>"
      release: "<YOUR_ENTITY_NAME>"
      pull_request: "<YOUR_ENTITY_NAME>"
      artifact: "<YOUR_ENTITY_NAME>"
      docker_image: "<YOUR_ENTITY_NAME>"
      kubernetes_pod: "<YOUR_ENTITY_NAME>"
      deployment: "<YOUR_ENTITY_NAME>"
      pipeline: "<YOUR_ENTITY_NAME>"
      pipeline_run: "<YOUR_ENTITY_NAME>"
    relationships:
      user_owns_repository: "<YOUR_TOPO_NAME>"
      repository_tags_release: "<YOUR_TOPO_NAME>"
      repository_contains_pull_request: "<YOUR_TOPO_NAME>"
      user_participates_in_pull_request: "<YOUR_TOPO_NAME>"
      release_contains_artifact: "<YOUR_TOPO_NAME>"
      artifact_same_as_docker_image: "<YOUR_TOPO_NAME>"
      pod_uses_docker_image: "<YOUR_TOPO_NAME>"
      release_relates_to_deployment: "<YOUR_TOPO_NAME>"
      repository_contains_pipeline: "<YOUR_TOPO_NAME>"
      pull_request_triggers_pipeline_run: "<YOUR_TOPO_NAME>"
      static_topo: "<YOUR_TOPO_NAME>"

tasks:
  enabled:
    - repository
    - user
    - release
    - user_owns_repository
    - repository_tags_release
    - pull_request
    - repository_contains_pull_request
    - user_participates_in_pull_request
    - docker_image
    - artifact
    - release_contains_artifact
    - artifact_same_as_docker_image
    - kubernetes_pod
    - pod_uses_docker_image
    # GitLab CI（GitLab 一等能力；无流水线的仓库自动为空）
    - pipeline
    - pipeline_run
    - repository_contains_pipeline
    - pull_request_triggers_pipeline_run
    - static_topo
    # 可选：配置 argocd 段后取消注释
    # - deployment
    # - release_relates_to_deployment
  interval: 300
  shared_data_ttl: 86400
  skip_sls_upload:
    - skip_to_upload
  dependencies:
    user: ["repository"]
    release: ["repository"]
    user_owns_repository: ["user", "repository"]
    repository_tags_release: ["repository", "release"]
    pull_request: ["repository"]
    repository_contains_pull_request: ["pull_request", "repository"]
    user_participates_in_pull_request: ["user", "pull_request"]
    docker_image: []
    artifact: ["docker_image"]
    release_contains_artifact: ["release", "docker_image"]
    artifact_same_as_docker_image: ["docker_image"]
    pod_uses_docker_image: ["kubernetes_pod", "docker_image"]
    pipeline: ["repository"]
    pipeline_run: ["repository", "pipeline"]
    repository_contains_pipeline: ["repository", "pipeline"]
    pull_request_triggers_pipeline_run: ["pull_request", "pipeline_run"]
    static_topo: ["repository", "release", "user"]
    # deployment: ["release"]
    # release_relates_to_deployment: ["release", "deployment"]

logging:
  level: INFO
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "logs/gitlab_data_generator.log"
